# S3-compatible object storage for product photos (AWS S3, Cloudflare R2, etc.).
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT_URL=
S3_PUBLIC_BASE_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
